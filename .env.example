# --- PostgreSQL ---
POSTGRES_USER=avp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=avp
DATABASE_URL=postgresql+psycopg://avp:change-me@localhost:5432/avp
# integration テスト専用（ADR-0021）。DB名は *_test、ホストはローカル、DATABASE_URL と別DBであること。
# テストは DATABASE_URL を読まない。未設定なら DB を使う integration テストは skip
TEST_DATABASE_URL=postgresql+psycopg://avp:change-me@localhost:5432/avp_test

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=artifacts

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=episode-skeleton

# --- Storyboard (ADR-0015 / ADR-0016) ---
# 一時作業領域（source of truth ではない）。MinIO の minio-data とは別の場所にする
AI_VIDEO_WORK_ROOT=/mnt/minio-hdd/ai-video-work
# OpenMontage 共有 checkout（読み取り専用）。固定 commit の blob だけを読む
OPENMONTAGE_REPO_PATH=
OPENMONTAGE_COMMIT=2fa571e39ad0632148dad77c7a2134f7e6fe0797
STORYBOARD_TIMEOUT_SECONDS=900

# --- Production (ADR-0017) ---
# task queue ごとの並行数（production-image / production-voice / production-video）
IMAGE_CONCURRENCY=2
VOICE_CONCURRENCY=1
VIDEO_CONCURRENCY=1
# ローカル TTS の音声モデル（未設定なら voice worker を組めない）
PIPER_VOICE_PATH=
# Piper を入れた隔離 venv の python（./scripts/setup-piper.sh が表示する）
PIPER_PYTHON=
# 合成パラメータ（空なら音声モデル .onnx.json の既定値）
# PIPER_LENGTH_SCALE=1.0
# PIPER_NOISE_SCALE=0.667
# PIPER_NOISE_W_SCALE=0.8
PRODUCTION_SUBMIT_TIMEOUT_SECONDS=120
PRODUCTION_AWAIT_TIMEOUT_SECONDS=2400
PRODUCTION_AWAIT_HEARTBEAT_SECONDS=90
PRODUCTION_POLL_INTERVAL_SECONDS=10
PRODUCTION_VOICE_TIMEOUT_SECONDS=300

# --- Render (Phase 5) ---
# 固定版 static ffmpeg（./scripts/install-render-ffmpeg.sh が表示する）。sha256 不一致なら起動しない
RENDER_FFMPEG_PATH=
RENDER_FFMPEG_SHA256=
RENDER_FFPROBE_PATH=
RENDER_FFPROBE_SHA256=
# 字幕フォント（パスと sha256 の組）
RENDER_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
RENDER_FONT_SHA256=b76b0433203017ca80401b2ee0dd69350349871c4b19d504c34dbdd80541690a
RENDER_FFMPEG_THREADS=4
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_SECONDS=1800
RENDER_MIN_FREE_BYTES=10737418240

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Providers (実キーはコミットしない。ローカルは .env に置く) ---
FAL_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# refresh token を置くファイル（repo の外、0600。scripts/youtube-oauth.py が書く）
YOUTUBE_REFRESH_TOKEN_PATH=
# 投稿先チャンネル id（UC...）。upload key の destination に入る（ADR-0020）
YOUTUBE_CHANNEL_ID=

# --- 停止スイッチ (failure-policy §7) ---
PAUSED=false
UPLOADS_PAUSED=false
