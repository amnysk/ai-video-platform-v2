# --- PostgreSQL ---
POSTGRES_USER=avp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=avp
DATABASE_URL=postgresql+psycopg://avp:change-me@localhost:5432/avp

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=artifacts

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=episode-skeleton

# --- Storyboard (ADR-0015 / ADR-0016) ---
# 一時作業領域（source of truth ではない）。MinIO の minio-data とは別の場所にする
AI_VIDEO_WORK_ROOT=/mnt/minio-hdd/ai-video-work
# OpenMontage 共有 checkout（読み取り専用）。固定 commit の blob だけを読む
OPENMONTAGE_REPO_PATH=
OPENMONTAGE_COMMIT=2fa571e39ad0632148dad77c7a2134f7e6fe0797
STORYBOARD_TIMEOUT_SECONDS=900

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Providers (実キーはコミットしない。ローカルは .env に置く) ---
FAL_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- 停止スイッチ (failure-policy §7) ---
PAUSED=false
UPLOADS_PAUSED=false
