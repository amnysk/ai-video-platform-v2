          "base_manifest_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Base Manifest Id"
          },
          "change": {
            "discriminator": {
              "mapping": {
                "scene.override_visual": "#/$defs/SceneOverrideVisual",
                "script.edit_scenes": "#/$defs/ScriptEditScenes"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ScriptEditScenes"
              },
              {
                "$ref": "#/$defs/SceneOverrideVisual"
              }
            ],
            "title": "Change"
          },
          "rationale": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rationale"
          },
          "variant_group": {
