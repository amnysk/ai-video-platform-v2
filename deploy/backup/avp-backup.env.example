# コピーして ~/.config/avp/backup.env（0600）にする。**ここに秘密を書くなら 0600 必須。**
# 保存先（既定なし。未設定だと scripts/backup.py は実行を拒否する）。
# 守る対象と別のデバイスに置く: DB の写しは MinIO と同じ HDD、オブジェクトの写しは NVMe、など。
# 本番データ（/mnt/minio-hdd/minio-data, ai-video-work）の中は不可。
AVP_BACKUP_DB_ROOT=
AVP_BACKUP_OBJECT_ROOT=

# 任意: 失敗通知（既定オフ）。argv に分割され、event の JSON が stdin に渡る。
#AVP_BACKUP_NOTIFY_CMD=/usr/local/bin/notify-owner
#AVP_BACKUP_NOTIFY_WEBHOOK=https://example.invalid/hook

# 任意: オフサイト（既定オフ = 外部送信なし）。{db_set} {object_set} が置換される。
# 送信先と資格情報は所有者が決める。送る前に暗号化されること（restic 等）。
#AVP_BACKUP_OFFSITE_CMD=restic -r <repo> backup {db_set} {object_set}
