{
  "policy": {
    "description": "TEST ONLY (compose.test.yaml): avp-infra-* rollover after 2 docs or 2m, delete 3m after rollover",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [{"rollover": {"min_doc_count": 2, "min_index_age": "2m"}}],
        "transitions": [{"state_name": "delete", "conditions": {"min_rollover_age": "3m"}}]
      },
      {"name": "delete", "actions": [{"delete": {}}], "transitions": []}
    ],
    "ism_template": [{"index_patterns": ["avp-infra-*"], "priority": 100}]
  }
}
