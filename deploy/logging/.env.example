# compose.logging.yaml が読む値（既定は本番用）。秘密は書かない（パスワード・鍵は AVP_LOGGING_SECRETS_DIR）。
# docker compose --env-file <このファイルの複製> -f deploy/logging/compose.logging.yaml ...
AVP_LOGGING_ENV=prod
# 既定: ~/.config/avp-logging/<env>（init-secrets.sh が作る。0700/0600）
#AVP_LOGGING_SECRETS_DIR=/home/USER/.config/avp-logging/prod
# rootless Docker の containers ディレクトリ（docker info --format '{{.DockerRootDir}}'/containers）
#AVP_LOG_CONTAINERS_DIR=/home/USER/.local/share/docker/containers
# 収集する compose project（完全一致）
AVP_LOG_TARGET_PROJECT=avp2
# host_name フィールド（別ホスト構成で区別する）
AVP_LOG_HOST_NAME=unknown
# 導入時だけ false で位置 DB を作る（platform.md §6）
AVP_LOG_READ_FROM_HEAD=true
AVP_LOG_STORAGE_LIMIT=1G
AVP_LOGGING_OS_PORT=9200
AVP_LOGGING_OSD_PORT=5601
AVP_LOGGING_OS_HEAP=1g
AVP_LOGGING_OS_MEM_LIMIT=2560m
# 別ホストの OpenSearch へ送るとき（fluent-bit を edge network にも繋ぐ override が要る）
AVP_LOGGING_OPENSEARCH_HOST=opensearch
AVP_LOGGING_OPENSEARCH_PORT=9200
# Fluent Bit の filesystem buffer の置き場所（既定は位置 DB と同じ volume）
AVP_LOG_STORAGE_PATH=/fb-state/buffer
# 試験だけ（compose.test.yaml が設定する）: 短縮 ISM policy と ISM の実行間隔（分）
#AVP_ISM_POLICY_DIR=ism-test
#AVP_ISM_JOB_INTERVAL_MIN=1
#AVP_LOG_BUFFER_TMPFS_SIZE=64m
