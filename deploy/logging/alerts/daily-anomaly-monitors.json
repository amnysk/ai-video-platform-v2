{
  "_meta": {
    "applied": false,
    "note": "定義だけ。適用しない（POST _plugins/_alerting/monitors は所有者の判断）。enabled=false・actions=[]（通知先未設定）。ログは副本のため、発火は『調べる合図』であり再開・投稿の根拠にしない（INV-38）。",
    "tested_against": "JSON 構文と read-only DSL のみ（tests/contract/test_logging_query_definitions.py）。OpenSearch Alerting plugin への適用は未検証。"
  },
  "monitors": [
    {
      "name": "avp-stage-stalled-recurring",
      "type": "monitor",
      "monitor_type": "query_level_monitor",
      "enabled": false,
      "schedule": {
        "period": {
          "interval": 1,
          "unit": "HOURS"
        }
      },
      "inputs": [
        {
          "search": {
            "indices": [
              "avp-app-prod-*"
            ],
            "query": {
              "size": 0,
              "query": {
                "bool": {
                  "filter": [
                    {
                      "term": {
                        "event_name": "anomaly.recorded"
                      }
                    },
                    {
                      "match_phrase": {
                        "message": "anomaly=EPISODE_STAGE_STALLED"
                      }
                    },
                    {
                      "range": {
                        "@timestamp": {
                          "gte": "now-2h"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "triggers": [
        {
          "name": "avp-stage-stalled-recurring-trigger",
          "severity": "2",
          "condition": {
            "script": {
              "source": "ctx.results[0].hits.total.value > 0",
              "lang": "painless"
            }
          },
          "actions": []
        }
      ],
      "_meta": {
        "description": "watchdog が停滞を直近2時間に記録した（毎時検査なので持続中。新規かは PG の new_incidents で判断）。"
      }
    },
    {
